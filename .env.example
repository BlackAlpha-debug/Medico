# Database - Supabase PostgreSQL Connection String
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations (without pgbouncer)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Better Auth Secret - Generate a random 32+ character string
# You can generate one at: https://generate-secret.vercel.app/32
BETTER_AUTH_SECRET="your-super-secret-key-at-least-32-chars"

# Better Auth URL - Your app's base URL
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google OAuth Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional: ElevenLabs API Key (TTS primary)
# Get this from https://elevenlabs.io -> Profile -> API Key
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# Groq API Key (clinical AI, report chat/regeneration, translation, safety, and Whisper STT)
# Get this from https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key"

# Optional: Uplift AI API Key (Urdu TTS secondary fallback)
# Get this from https://platform.upliftai.org/studio/home
UPLIFT_API_KEY="your-uplift-api-key"

# Pinecone API Key (medical knowledge RAG; index must use 384 dimensions)
# Get this from https://www.pinecone.io/
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="medical-fast-search"
# Keep false until the index contains an approved, reviewed medical corpus.
RAG_ENABLED="false"

# Gemini clinical reasoning
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_TEXT_MODEL="your-enabled-gemini-flash-model"
GEMINI_TRANSCRIBE_MODEL="your-enabled-gemini-transcription-model"
AI_MAX_OUTPUT_TOKENS="1200"

# TTS code remains available, but providers are not called while this is false.
TTS_ENABLED="false"

# LiveKit Configuration (for real-time voice communication)
# Get these from https://cloud.livekit.io
#LIVEKIT_API_KEY="your-livekit-api-key"
#LIVEKIT_API_SECRET="your-livekit-api-secret"
#LIVEKIT_WS_URL="wss://your-project.livekit.cloud"

